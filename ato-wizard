#!/usr/bin/env python3
"""Portable kit entrypoint: pick a repository, choose/resume text or diagram work."""
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
if __name__ == '__main__':
    # Prefer the repository-local optional environment; never auto-install dependencies.
    prepared = ROOT / '.venv-tui' / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
    if prepared.is_file() and Path(sys.prefix).resolve() != (ROOT / '.venv-tui').resolve():
        os.execv(str(prepared), [str(prepared), str(Path(__file__).resolve()), *sys.argv[1:]])
    sys.path.insert(0, str(ROOT / 'sspp-assembly-framework/tools'))
    from launcher import main
    main()
